{
  "name": "Flutter Ultimate Workspace",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "postCreateCommand": "flutter config --enable-web && flutter pub upgrade --major-versions",
  "customizations": {
    "vscode": {
      "extensions": [
        "dart-code.flutter",
        "dart-code.dart-code"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}
